{
  "version": 2,
  "rewrites": [
    {
      "source": "/bsc",
      "destination": "/CMH-BROKER-SHARE-COCKPIT.html"
    },
    {
      "source": "/broker",
      "destination": "/CMH-BROKER-SHARE-COCKPIT.html"
    },
    {
      "source": "/((?!api/|CMH_TRADE_SCENARIO_SIMULATOR_V1.xlsx|CMH-BROKER-SHARE-COCKPIT.html|bsc.html|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}